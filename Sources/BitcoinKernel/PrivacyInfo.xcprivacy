<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required-reason declarations for this SDK's own code. Because the product
	     links statically, an embedding app must also declare these categories in
	     its own manifest — upload validation does not reliably consult SDK
	     resource bundles. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- The kernel stats block, chainstate and log files inside the
			     app's own container (fstat, fs::file_size, leveldb ::stat)
			     to size and order its writes. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- CheckDiskSpace (fs::space → statvfs) runs before the kernel
			     writes block files; GetFilesystemType probes statfs to
			     detect exFAT data dirs. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
		<dict>
			<!-- randomenv.cpp mixes kern.boottime (via sysctl) into the RNG
			     entropy pool. No approved reason literally says "entropy";
			     35F9.1 is the closest sanctioned fit — the value never
			     leaves the device. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
